<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConvertPro.ReglagesPage" Title="Réglages" BackgroundColor="{AppThemeBinding Light=#EEF1F6, Dark=#0F1523}">
    <ScrollView><VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Conversion" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1B2A49, Dark=#E8ECF5}" />
        <Picker x:Name="Dec" Title="Nombre de décimales" SelectedIndexChanged="OnDec" />
        <Picker x:Name="Theme" Title="Thème" SelectedIndexChanged="OnTheme" />
        <Picker x:Name="Cur" Title="Devise préférée" SelectedIndexChanged="OnCur" />
        <Label Text="Données et hors connexion" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1B2A49, Dark=#E8ECF5}" />
        <Grid ColumnDefinitions="*,Auto"><Label Text="Enregistrer les taux (utiliser sans connexion)" VerticalOptions="Center" /><Switch x:Name="Cache" Grid.Column="1" Toggled="OnCache" /></Grid>
        <Label x:Name="Rates" TextColor="{AppThemeBinding Light=#1B2A49, Dark=#E8ECF5}" />
        <Button Text="Actualiser les taux de démo" Clicked="OnRefresh" BackgroundColor="#1F3A68" TextColor="White" />
        <Label Text="ConvertPro 1.0.0 · Données de démonstration, non temps réel. Favoris, historique et préférences restent sur l'appareil." FontSize="12" TextColor="{AppThemeBinding Light=#5B6785, Dark=#A9B4CC}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
