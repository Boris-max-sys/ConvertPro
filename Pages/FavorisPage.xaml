<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConvertPro.FavorisPage" Title="Favoris" BackgroundColor="#EEF1F6">
    <CollectionView x:Name="List" Margin="16" SelectionMode="Single" SelectionChanged="OnTap">
        <CollectionView.EmptyView><Label Text="Aucun favori. Touchez ☆ sur un résultat." TextColor="#5B6785" /></CollectionView.EmptyView>
        <CollectionView.ItemTemplate><DataTemplate>
            <Border Padding="14" Margin="0,4" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout><Label Text="{Binding Title}" FontAttributes="Bold" TextColor="#1B2A49" /><Label Text="{Binding Sub}" FontSize="12" TextColor="#5B6785" /></VerticalStackLayout>
            </Border>
        </DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
