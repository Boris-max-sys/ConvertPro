<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConvertPro.HistoriquePage" Title="Historique" BackgroundColor="{AppThemeBinding Light=#EEF1F6, Dark=#0F1523}">
    <ContentPage.ToolbarItems><ToolbarItem Text="Tout effacer" Clicked="OnClear" /></ContentPage.ToolbarItems>
    <CollectionView x:Name="List" Margin="16">
        <CollectionView.EmptyView><Label Text="Aucune conversion pour le moment." TextColor="{AppThemeBinding Light=#5B6785, Dark=#A9B4CC}" /></CollectionView.EmptyView>
        <CollectionView.ItemTemplate><DataTemplate>
            <Border Padding="14" Margin="0,4" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2336}" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout><Label Text="{Binding Title}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1B2A49, Dark=#E8ECF5}" /><Label Text="{Binding Sub}" FontSize="12" TextColor="{AppThemeBinding Light=#5B6785, Dark=#A9B4CC}" /></VerticalStackLayout>
            </Border>
        </DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
