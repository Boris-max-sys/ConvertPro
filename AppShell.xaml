<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:ConvertPro"
       x:Class="ConvertPro.AppShell" Shell.TabBarBackgroundColor="White"
       Shell.TabBarTitleColor="#1F3A68" Shell.NavBarIsVisible="True">
    <TabBar>
        <ShellContent Title="Convertir" Route="convert" ContentTemplate="{DataTemplate local:ConvertPage}" />
        <ShellContent Title="Favoris" Route="favoris" ContentTemplate="{DataTemplate local:FavorisPage}" />
        <ShellContent Title="Historique" Route="historique" ContentTemplate="{DataTemplate local:HistoriquePage}" />
        <ShellContent Title="Réglages" Route="reglages" ContentTemplate="{DataTemplate local:ReglagesPage}" />
    </TabBar>
</Shell>
